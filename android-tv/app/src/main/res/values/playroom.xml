<resources>
    <style name="PairingTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF8E9</item>
        <item name="android:colorAccent">#6539AE</item>
        <item name="android:textColorPrimary">#322448</item>
        <item name="android:buttonStyle">@style/PairingButton</item>
    </style>
    <style name="PairingButton" parent="@android:style/Widget.Material.Light.Button">
        <item name="android:background">@drawable/pairing_button</item>
        <item name="android:textColor">#322448</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/jua</item>
        <item name="android:textSize">20sp</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
