<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-feature android:name="android.software.leanback" android:required="true"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="FamilyTV" android:icon="@android:drawable/ic_media_play" android:banner="@android:drawable/ic_media_play" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".PlaybackActivity" android:exported="false" android:screenOrientation="landscape"/>
        <activity android:name=".ViewerActivity" android:theme="@style/PairingTheme" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
